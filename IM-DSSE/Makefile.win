# Compiler & flags
CXX := g++
CXXFLAGS := -std=c++11 -Wall -g -O0 -fPIC
INCLUDES := -I. -I/mingw64/include
LDFLAGS := -L/mingw64/lib
LIBS := -lzmq -lboost_iostreams-mt -ltomcrypt

# Target binary
TARGET := Debug/im-dsse-client.exe

# Source files for client only
SRCS := \
    Client_DSSE.cpp \
    Krawczyk128_KDF.cpp \
    MasterKey.cpp \
    DSSE_KeyGen.cpp \
    DSSE.cpp \
    Miscellaneous.cpp \
    DSSE_Hashmap_Key_Class.cpp \
    DSSE_Trapdoor.cpp \
    Keyword_Extraction.cpp \
    DSSE_Crypto.cpp \
    main.cpp \
    struct_thread_getData.cpp \
    struct_thread_precompute_aeskey.cpp

# Object files (semua ke folder Debug)
OBJS := $(SRCS:%.cpp=Debug/%.o)

# Build rules
all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LIBS)

# Aturan untuk compile setiap .cpp ke Debug/*.o
Debug/%.o: %.cpp | Debug
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

# Pastikan folder Debug ada
Debug:
	mkdir -p Debug

clean:
	rm -f Debug/*.o $(TARGET)

.PHONY: all clean
