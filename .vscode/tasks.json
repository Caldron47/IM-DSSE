{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Client (Debug)",
      "type": "shell",
      "command": "make -C IM-DSSE -f Makefile.win",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
